# Leave these empty to run in DEMO MODE (data is stored only in this browser).
# Fill them in (Supabase -> Project Settings -> API) to enable real login + cloud database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (never prefix with NEXT_PUBLIC_). Used by the daily alert-sync cron job.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
